          "name": "巨型类人生物 Gargantuan Humanoid",
          "delta": {
            "name": null,
            "skills": {},
            "items": {
              "zGtSO1t7RINeWEir": {
                "name": "重整队列 Form Up",
                "description": "<p>@Localize[PF2E.NPC.Abilities.Glossary.FormUp]</p>",
                "gmDescription": "",
                "heighteningLevels": {},
                "overlays": {},
                "kitContents": {}
              },
              "rwLMgxOYWCHlCD7R": {
                "name": "部队防御 Troop Defenses",
                "description": "<p><strong>阈值</strong> 70（12格）、35（8格）</p>\n<hr />\n<p>@Localize[PF2E.NPC.Abilities.Glossary.TroopDefenses]</p>",
                "gmDescription": "",
                "heighteningLevels": {},
                "overlays": {},
                "kitContents": {}
              },
              "1hGao82GHZbkFICr": {
                "name": "集体痛殴 Group Beatdown",
                "description": "<p><span class=\"action-glyph\">1</span>至<span class=\"action-glyph\">3</span></p>\n<p><strong>频率</strong> 每轮一次</p>\n<hr />\n<p><strong>效果</strong> 部队攻击5尺内的敌人（@Check[type:reflex|dc:21|basic:true]），伤害取决于动作数。</p>\n<p><span class=\"action-glyph\">1</span> @Damage[(1d6+3)[bludgeoning]]伤害</p>\n<p><span class=\"action-glyph\">2</span> @Damage[(2d10+6)[bludgeoning]]伤害</p>\n<p><span class=\"action-glyph\">3</span> @Damage[(2d10+9)[bludgeoning]]伤害</p>",
                "gmDescription": "",
                "heighteningLevels": {},
                "overlays": {},
                "kitContents": {}
              },
              "fa962sidQFXoub56": {
                "name": "部队移动 Troop Movement",
                "description": "<p>每当幽灵暴民行走时，它会先以一个自由动作重整队列，收拢到20尺×20尺的区域内（减去已损失的方格），然后再移动。这如同一个巨型生物的移动；例如，只要幽灵暴民的任一方格进入困难地形，额外移动消耗就会作用于整个群体。</p>",
                "gmDescription": "",
                "heighteningLevels": {},
                "overlays": {},
                "kitContents": {}
              },
              "BsGczgbZh31zNCzF": {
                "name": "本地学识 Local Lore",
                "description": "",
                "gmDescription": "",
                "heighteningLevels": {},
                "overlays": {},
                "kitContents": {}
              },
              "sw2cUfwefogSDPHR": {
                "name": "大众之力 Power of the Mob",
                "description": "<p>处于第一阈值时，平民在用于@UUID[Compendium.pf2e.actionspf2e.Item.7blmbDrQFNfdT731]{推撞}的运动检定、攻击检定和伤害掷骰上获得+2环境加值；到了第二阈值，该加值降至+1，第三阈值则降至0。</p>",
                "gmDescription": "",
                "heighteningLevels": {},
                "overlays": {},
                "kitContents": {}
              }
            }
          }
        }
